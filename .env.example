# ---------------------------------------------------------------------------
# DataBridge — example environment. Copy to backend/.env and adjust.
# The web app reads frontend/.env.local (see frontend/.env.example).
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
APP_URL=http://localhost:3000    # the web app; the only origin CORS allows
PUBLIC_API_URL=http://localhost:8000   # used to build webhook URLs shown to users

# SQLite by default. PostgreSQL: postgresql+psycopg://user:password@localhost:5432/databridge
DATABASE_URL=sqlite:///./databridge.db

#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Encrypts stored API credentials (Fernet). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty in development, a key is derived from SECRET_KEY. Required in production.
CREDENTIALS_KEY=
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=true

# --- Outbound requests ------------------------------------------------------------
# Private, loopback and link-local addresses are refused (SSRF protection).
# The built-in demo APIs are the one exception: requests to PUBLIC_API_URL/demo/*.
HTTP_TIMEOUT_SECONDS=15
MAX_RESPONSE_MB=5
MAX_RECORDS_PER_RUN=5000
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5

# --- Scheduler -------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
